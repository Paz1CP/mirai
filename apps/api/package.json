{
  "name": "@mirai/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/bootstrap/server.ts",
    "build": "pnpm -w exec tsc -p apps/api/tsconfig.build.json",
    "start": "node dist/bootstrap/server.js",
    "lint": "eslint .",
    "typecheck": "pnpm -w exec tsc -p apps/api/tsconfig.json --noEmit",
    "db:check": "tsx src/infrastructure/database/checkConnection.ts",
    "storage:check": "tsx src/infrastructure/storage/checkConnection.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1169.0",
    "@aws-sdk/s3-request-presigner": "^3.1170.0",
    "@google/genai": "^3.4.0",
    "@mirai/contracts": "workspace:*",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "jose": "^6.2.17",
    "mammoth": "^1.13.0",
    "multer": "^2.5.0",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15"
  }
}
