{
  "name": "@mirai/extension",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build && wxt build -b firefox",
    "zip": "wxt zip && wxt zip -b firefox",
    "typecheck": "wxt prepare && pnpm -w exec tsc -p apps/extension/tsconfig.json --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@mirai/contracts": "workspace:*",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/chrome": "0.3.7",
    "@types/node": "^26.6.6",
    "wxt": "^0.21.5"
  }
}
